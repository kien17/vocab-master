# Environment Variables Template

# ============================================
# SUPABASE CONFIGURATION
# ============================================

# Get from: https://app.supabase.com → Settings → API
# Format: https://[PROJECT-ID].supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon Key (for client-side)
# Get from: https://app.supabase.com → Settings → API → anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (for server-side only)
# Get from: https://app.supabase.com → Settings → API → service_role key
# ⚠️ NEVER expose this to client-side!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# GOOGLE GEMINI API
# ============================================

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyD...

# ============================================
# APP CONFIGURATION
# ============================================

# App name
NEXT_PUBLIC_APP_NAME=Vocab Master

# API URL (for client-side requests)
# Development: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# OPTIONAL: AUTHENTICATION
# ============================================

# If using Supabase Auth
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_AUTH_PROVIDER=supabase

# ============================================
# OPTIONAL: ANALYTICS
# ============================================

# Google Analytics or other tracking
NEXT_PUBLIC_GA_ID=
